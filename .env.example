# Copy to .env.local (never commit it). Production values live in Vercel project settings.
# Secrets: 32 random bytes, base64 each →  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Neon POOLED connection string (host contains -pooler). Used by the app.
# Leave empty for local work without credentials: the app falls back to PGlite in ../.pglite-<folder>.
# Also accepts a plain Postgres URL (e.g. Docker) or pglite:<dir> / pglite:memory.
DATABASE_URL=
# Neon DIRECT (unpooled) connection string. Used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Ably API key (server only; browsers get subscribe-only tokens from /api/realtime/token).
# Leave empty to run without real-time: events are recorded and logged instead of sent.
ABLY_API_KEY=

# Session JWT signing key.
JWT_SECRET=
# Encrypts personal invite links. Rotating it breaks every unclaimed personal link.
INVITE_LINK_SECRET=
# Encrypts webhook URLs and signing secrets at rest. Rotating it makes them unreadable.
APP_ENCRYPTION_KEY=

# Base URL used to build invite and reset links.
PUBLIC_APP_URL=http://localhost:3000

# Optional: pino log level (fatal|error|warn|info|debug|trace|silent).
LOG_LEVEL=info

# Optional: real Postgres for `npm run test:concurrency` (throwaway Neon branch or Docker).
CONCURRENCY_DATABASE_URL=
