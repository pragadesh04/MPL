    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "pino": "^10.4.0",
