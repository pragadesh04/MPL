{
  "name": "mpl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:concurrency": "vitest run --config vitest.concurrency.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "user:reset-password": "tsx scripts/user-reset-password.ts",
    "verify": "npm run lint && npm run format:check && npm run type-check && npm run test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@hookform/resolvers": "^7.0.8",
